{
  "info": {
    "name": "Task API - Role Authorization Tests",
    "description": "Test collection for role-based authorization (admin, manager, employee)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000/api"},
    {"key": "adminToken", "value": ""},
    {"key": "managerToken", "value": ""},
    {"key": "employeeToken", "value": ""},
    {"key": "adminId", "value": ""},
    {"key": "managerId", "value": ""},
    {"key": "employeeId", "value": ""},
    {"key": "taskId", "value": ""}
  ],
  "item": [
    {
      "name": "1. Setup - Create Test Users",
      "item": [
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Admin User\", \"email\": \"admin@test.com\", \"password\": \"password123\"}"
            },
            "description": "Create admin test user"
          }
        },
        {
          "name": "Register Manager User",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Manager User\", \"email\": \"manager@test.com\", \"password\": \"password123\"}"
            }
          }
        },
        {
          "name": "Register Employee User",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Employee User\", \"email\": \"employee@test.com\", \"password\": \"password123\"}"
            }
          }
        },
        {
          "name": "Assign Admin Role",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/assign-role/admin/{{adminId}}",
            "description": "Assign admin role to admin user (requires authentication)"
          }
        },
        {
          "name": "Assign Manager Role",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/assign-role/manager/{{managerId}}",
            "description": "Assign manager role (via admin)"
          }
        },
        {
          "name": "Assign Employee Role",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/assign-role/employe/{{employeeId}}",
            "description": "Assign employee role (via admin)"
          }
        }
      ]
    },
    {
      "name": "2. Authentication - Login Each Role",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@test.com\", \"password\": \"password123\"}"
            },
            "description": "Login as admin - save token to {{adminToken}}"
          }
        },
        {
          "name": "Login as Manager",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"manager@test.com\", \"password\": \"password123\"}"
            },
            "description": "Login as manager - save token to {{managerToken}}"
          }
        },
        {
          "name": "Login as Employee",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"employee@test.com\", \"password\": \"password123\"}"
            },
            "description": "Login as employee - save token to {{employeeToken}}"
          }
        }
      ]
    },
    {
      "name": "3. Admin Routes - Should Work for Admin Only",
      "item": [
        {
          "name": "GET /users (Admin Access - Should 200)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/users",
            "description": "Admin can view all users - expect 200 OK"
          }
        },
        {
          "name": "GET /users (Manager Access - Should 403)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"}
            ],
            "url": "{{baseUrl}}/users",
            "description": "Manager cannot view users list - expect 403 Forbidden"
          }
        },
        {
          "name": "GET /users (Employee Access - Should 403)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/users",
            "description": "Employee cannot view users list - expect 403 Forbidden"
          }
        },
        {
          "name": "POST /create-user (Admin Access - Should 200/422)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/create-user",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"New User\", \"email\": \"newuser@test.com\", \"password\": \"password123\"}"
            },
            "description": "Admin can create users - expect 200/201/422"
          }
        },
        {
          "name": "POST /create-user (Manager Access - Should 403)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{managerToken}}"}
            ],
            "url": "{{baseUrl}}/create-user",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"New User\", \"email\": \"newuser2@test.com\", \"password\": \"password123\"}"
            },
            "description": "Manager cannot create users - expect 403 Forbidden"
          }
        },
        {
          "name": "GET /statistique-task (Admin Access - Should 200)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/statistique-task",
            "description": "Admin can view task statistics - expect 200 OK"
          }
        }
      ]
    },
    {
      "name": "4. Manager Routes - Should Work for Manager & Admin",
      "item": [
        {
          "name": "POST /team-tasks (Manager Access - Should 200/201/422)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{managerToken}}"}
            ],
            "url": "{{baseUrl}}/team-tasks",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Team Task\", \"description\": \"Team task description\", \"priority\": \"high\", \"assigned_to\": null}"
            },
            "description": "Manager can create team tasks - expect 200/201/422"
          }
        },
        {
          "name": "POST /team-tasks (Employee Access - Should 403)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/team-tasks",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Team Task\", \"priority\": \"high\"}"
            },
            "description": "Employee cannot create team tasks - expect 403 Forbidden"
          }
        },
        {
          "name": "GET /team-tasks/{userId} (Manager Access - Should 200)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"}
            ],
            "url": "{{baseUrl}}/team-tasks/{{employeeId}}",
            "description": "Manager can view team member tasks - expect 200 OK"
          }
        }
      ]
    },
    {
      "name": "5. Employee Routes - Task Management",
      "item": [
        {
          "name": "GET /tasks/{id} (Employee Access - Should 200)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "description": "Employee can view assigned tasks - expect 200 OK"
          }
        },
        {
          "name": "PUT /tasks/{id}/status (Employee Access - Should 200/422)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"in_progress\"}"
            },
            "description": "Employee can update task status - expect 200/422"
          }
        }
      ]
    },
    {
      "name": "6. Policy Authorization Tests - Tasks",
      "item": [
        {
          "name": "View Own Task (Policy: view)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "description": "User can view task if creator or assignee - expect 200 OK"
          }
        },
        {
          "name": "View Unauthorized Task (Should 403)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/tasks/999",
            "description": "User cannot view task they don't have access to - expect 404/403"
          }
        },
        {
          "name": "Update Task as Creator (Policy: update)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{managerToken}}"}
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Updated Title\", \"priority\": \"high\"}"
            },
            "description": "Only creator can update task - expect 200 if creator"
          }
        }
      ]
    },
    {
      "name": "7. Cleanup - Logout",
      "item": [
        {
          "name": "Logout Admin",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "url": "{{baseUrl}}/logout"
          }
        },
        {
          "name": "Logout Manager",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"}
            ],
            "url": "{{baseUrl}}/logout"
          }
        },
        {
          "name": "Logout Employee",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{employeeToken}}"}
            ],
            "url": "{{baseUrl}}/logout"
          }
        }
      ]
    }
  ]
}
